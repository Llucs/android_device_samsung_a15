on boot
    # Brilho da tela e sensores Samsung
    chown system system /sys/class/backlight/panel0-backlight/brightness
    chmod 0664 /sys/class/backlight/panel0-backlight/brightness

on post-fs
    # Forçar o carregamento de módulos específicos se necessário
    exec u:r:magisk:s0 root root -- /system/bin/modprobe -a -d /vendor/lib/modules
