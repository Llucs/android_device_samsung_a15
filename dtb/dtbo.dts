/dts-v1/;

/ {
	compatible = "Mediatek,MT6789\0Samsung,A15 EUR OPEN 00";
	dtbo-hw_rev = <0x00>;
	dtbo-hw_rev_end = <0x03>;

	fragment@smd {
		target-path = "/";

		__overlay__ {

			samsung_mobile_device {
				compatible = "simple-bus";
				phandle = <0x80>;

				sec_vibrator {
					status = "okay";
					compatible = "sec_vibrator";
					haptic,normal_ratio = <0x64>;
					haptic,high_temp_ref = <0x30>;
					haptic,high_temp_ratio = <0x41>;
				};

				vibrator_info {
					status = "okay";
					compatible = "samsung,vib-info";
					functions = [00];
					samsung,intensities;
					samsung,haptic_intensities;
					phandle = <0x81>;
				};

				input_booster {
					status = "okay";
					compatible = "input_booster";
					resValcount = "2";
					max_resource_count = "3";
					max_cluster_count = "3";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					cpu_cluster_policy = "6,0";
					ib_release_values = "-1,16,0";
					allowed_resources = "0,1";

					booster_key@1 {
						input_booster,label = "key";
						input_booster,type = <0x00>;
						input_booster,head_time = <0xc8>;
						input_booster,tail_time = <0x00>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x137090 0x00>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x00 0x00>;
							};
						};
					};

					booster_key@2 {
						input_booster,label = "touchkey";
						input_booster,type = <0x01>;
						input_booster,head_time = <0x01>;
						input_booster,tail_time = <0x12c>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x00 0x106800>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x00 0x00>;
							};
						};
					};

					booster_key@3 {
						input_booster,label = "touch";
						input_booster,type = <0x02>;
						input_booster,head_time = <0x82>;
						input_booster,tail_time = <0x1f4>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x137090 0x106800>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x10aa 0x10aa>;
							};
						};
					};

					booster_key@4 {
						input_booster,label = "multitouch";
						input_booster,type = <0x03>;
						input_booster,head_time = <0x3e8>;
						input_booster,tail_time = <0x1f4>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x137090 0x106800>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x00 0x00>;
							};
						};
					};

					booster_key@5 {
						input_booster,label = "keyboard";
						input_booster,type = <0x04>;
						input_booster,head_time = <0x82>;
						input_booster,tail_time = <0x82>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x106800 0x106800>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x00 0x00>;
							};
						};
					};

					booster_key@6 {
						input_booster,label = "MOUSE";
						input_booster,type = <0x05>;
						input_booster,head_time = <0xc8>;
						input_booster,tail_time = <0x12c>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x137090 0x106800>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x00 0x00>;
							};
						};
					};

					booster_key@7 {
						input_booster,label = "mouse_wheel";
						input_booster,type = <0x06>;
						input_booster,head_time = <0xc8>;
						input_booster,tail_time = <0x00>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x137090 0x00>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x00 0x00>;
							};
						};
					};

					booster_key@8 {
						input_booster,label = "pen_hover";
						input_booster,type = <0x07>;
						input_booster,head_time = <0xc8>;
						input_booster,tail_time = <0x12c>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x137090 0x106800>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x00 0x00>;
							};
						};
					};

					booster_key@9 {
						input_booster,label = "pen";
						input_booster,type = <0x08>;
						input_booster,head_time = <0xc8>;
						input_booster,tail_time = <0x258>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "CPU";
								resource,value = <0x1a3ec0 0x106800>;
							};

							resource@2 {
								resource,label = "DDR";
								resource,value = <0x00 0x00>;
							};
						};
					};
				};

				sm5714-charger {
					status = "disable";
					compatible = "samsung,sm5714-charger";
					sm5714,chg_float_voltage_down_en = <0x01>;
					sm5714,chg_float_voltage_down_offset_mv = <0x14>;
					phandle = <0x82>;
