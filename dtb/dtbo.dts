				brightness-array = <0x13 0x30 0x36 0x3a 0x3f 0x43 0x46 0x49 0x4b 0x4d 0x64>;
			};

			aliases {
				i2c30 = "/i2c@30";
			};

			i2c@30 {
				cell-index = <0x1e>;
				compatible = "i2c-gpio";
				gpios = <0xffffffff 0x68 0x00 0xffffffff 0x67 0x00>;
				#i2c-gpio,delay-us = <0x02>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <0x13 0x14>;
				status = "okay";
				clock-frequency = <0x61a80>;
				phandle = <0x8b>;

				sx9385-i2c@29 {
					compatible = "sx9385";
					reg = <0x29>;
					status = "okay";
					pinctrl-names = "default";
					pinctrl-0 = <0x15 0x16>;
					interrupt-parent = <0xffffffff>;
					interrupts = <0x0c 0x00 0x00>;
					sx9385,ldo_en = <0xffffffff 0x54 0x00>;
					sx9385,nirq-gpio = <0xffffffff 0x0c 0x00>;
					sx9385,unknown_sel = <0x03>;
					sx9385,main-phases = <0x14>;
					sx9385,ref-phases = <0x0a>;
					sx9385,num_of_channels = <0x02>;
					sx9385,num_of_refs = <0x02>;
					sx9385,reg-num = <0x29>;
					sx9385,reg-init = [02 00 04 30 05 18 07 c0 08 11 0b 0a 0d 06 0e 66 47 56 4d 56 54 46 5a 46 48 05 4e 05 55 04 5b 04 49 27 4f 27 56 3f 5c 3f 79 12 7a 20 80 20 7b 60 7d 35 81 60 7c 4a 82 00 83 35 7e 14 84 80 7f 1b 91 00 92 00 9e 00 8c 00 4a 40 50 04 57 10 5d 01 09 78];
					phandle = <0x8c>;
				};
			};

			sec-audio-sysfs {
				compatible = "samsung,audio-sysfs";
				status = "okay";
			};

			usb_notifier {
				compatible = "samsung,usb-notifier";
				disable_host_wakelock;
			};
		};
	};

